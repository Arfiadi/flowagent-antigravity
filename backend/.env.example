# FlowAgent Backend — Environment Variables Template
# Copy this file to .env and fill in your values.

FIREBASE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
VERTEX_AI_LOCATION=us-central1

# Dual-Model Configuration (PRD §3)
# SENSE Layer: Fast extraction & OCR (Gemini Flash)
GEMINI_SENSE_MODEL=gemini-2.5-flash
# THINK Layer: Deep reasoning & action generation (Gemini Pro)
GEMINI_THINK_MODEL=gemini-2.5-pro
